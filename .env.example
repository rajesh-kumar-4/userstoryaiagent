# Copy to .env and fill in values. Never commit .env.
# API_KEYS is a JSON object of API key -> role. Roles: VIEWER, ANALYST, ADMIN.
API_KEYS='{"change-me-admin-key":"ADMIN"}'
# Host folder that contains the repositories to analyse. Defaults to the parent of this folder.
WORKSPACE_DIR=..
FRONTEND_PORT=8080
LOG_LEVEL=INFO
# none | openai | azure_openai | ollama | generative_engine. "none" uses rule-based summaries.
# Provider credentials (LLM_API_KEY, LLM_MODEL, LLM_BASE_URL, ...) are documented in docs/DEPLOYMENT.md.
LLM_PROVIDER=none
